erDiagram
    APPLICATION ||--o{ DOCUMENT : contains
    DOCUMENT ||--o{ DOCUMENT_ISSUE : "has problems"
    APPLICATION ||--o{ REVIEW_ITEM : needs
    APPLICATION ||--o{ FLAG : raises
    APPLICATION ||--o{ INFO_REQUEST : has
    APPLICATION ||--o{ PACKAGE : "versioned as"
    PACKAGE ||--o| CONSENT : "approved by"
    USER ||--o{ CONSENT : grants
    PACKAGE ||--o| BANK_SUBMISSION : "sent as"
    BANK_SUBMISSION ||--o{ BANK_EVENT : receives
    APPLICATION ||--o| BANK_DECISION : receives
    USER ||--o{ AUDIT_LOG : performs
    USER {
        uuid id PK
        uuid org_id FK "null for ops and bank users"
        string role "sme_owner | ops_analyst | bank_analyst"
        string email UK
    }
    APPLICATION {
        uuid id PK
        uuid org_id FK
        string status
    }
    REVIEW_ITEM {
        uuid id PK
        uuid application_id FK
        string entity_type "invoice | bank_transaction"
        uuid entity_id
        string field_name
        string extracted_value
        string corrected_value
        float confidence
        string status "open | confirmed | corrected"
        uuid reviewed_by FK
    }
    FLAG {
        uuid id PK
        uuid application_id FK
        string type "low_match_rate | duplicate | activity_gap | related_party | ..."
        string severity "info | warning | critical"
        string entity_type
        uuid entity_id
        string status "open | resolved"
        string resolution_note "visible to bank"
        uuid resolved_by FK
    }
    INFO_REQUEST {
        uuid id PK
        uuid application_id FK
        uuid requested_by FK
        string target "sme | ops"
        string message
        string status "open | answered"
    }
    PACKAGE {
        uuid id PK
        uuid application_id FK
        int version
        json metrics "revenue trend, match rate, concentration"
        string summary_pdf_url
        timestamp generated_at
    }
    CONSENT {
        uuid id PK
        uuid package_id FK
        uuid user_id FK
        string bank_name
        json data_scope
        timestamp granted_at
        timestamp revoked_at
    }
    BANK_SUBMISSION {
        uuid id PK
        uuid package_id FK
        string idempotency_key UK
        string bank_reference
        string status "sending | acknowledged | unconfirmed"
        int attempts
        timestamp sent_at
        timestamp acknowledged_at
    }
    BANK_DECISION {
        uuid id PK
        uuid application_id FK
        string decision "approved | declined | conditional"
        decimal approved_amount_sar
        string terms
        timestamp decided_at
    }
    AUDIT_LOG {
        uuid id PK
        uuid actor_id FK
        string action
        string entity_type
        uuid entity_id
        json before_value
        json after_value
        timestamp created_at
    }
    DOCUMENT {
        uuid id PK
        uuid application_id FK
        string type
    }
    DOCUMENT_ISSUE {
        uuid id PK
        uuid document_id FK
        string location "sheet and row, or page"
        string code "MISSING_MONTH | BAD_DATE | DUPLICATE | ..."
        string message "shown to the SME"
        string suggested_fix
        string status "open | fixed"
    }
    BANK_EVENT {
        uuid id PK
        uuid submission_id FK
        string event_id UK "dedupe key from the bank"
        string channel "webhook | status_read"
        string reported_status
        json raw_payload
        boolean accepted "false = rejected by state guard"
        timestamp received_at
    }
